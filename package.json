{
  "name": "infocampus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma migrate deploy && prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "jest",
    "format:check": "bash scripts/formatCheckChanged.sh",
    "lint:prettier:check": "prettier --check .",
    "lint:prettier:fix": "prettier --write .",
    "commitlint": "commitlint --from HEAD~1 --to HEAD",
    "secretlint": "secretlint \"**/*\" --secretlintignore .secretlintignore",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy && prisma generate",
    "db:migrate:status": "prisma migrate status",
    "db:seed:universities": "node scripts/seedUniversities.js",
    "db:seed:domains": "node scripts/seedUniversityDomains.js",
    "db:seed": "npm run db:seed:universities && npm run db:seed:domains"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@prisma/client": "^5.22.0",
    "@tailwindcss/postcss": "^4.1.18",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.3.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.574.0",
    "next": "^14.2.35",
    "prisma": "^5.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^6.9.2",
    "swagger-ui-react": "^4.19.1",
    "tailwindcss": "^4.1.18"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@secretlint/secretlint-rule-preset-recommend": "^11.3.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "jest": "^29.7.0",
    "prettier": "^3.8.1",
    "secretlint": "^11.3.1"
  }
}
