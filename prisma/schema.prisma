generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UniversityType {
  PUBLIC
  PRIVATE
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

enum ModerationStatus {
  APPROVED
  PENDING_MODERATION
  REJECTED_OFFENSIVE
  REJECTED_NONSENSE
  REJECTED_OTHER
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

model University {
  id        String              @id @default(uuid())
  name      String              @unique
  location  String
  website   String?
  image     String?
  type      UniversityType
  courses   String[]
  rating    Float?
  createdAt DateTime            @default(now())
  reviews     Review[]
  domains     UniversityDomain[]
  users       User[]
  submissions UniversitySubmission[]
}

model UniversityDomain {
  id           String     @id @default(uuid())
  domain       String     @unique
  universityId String
  university   University @relation(fields: [universityId], references: [id])
  createdAt    DateTime   @default(now())
}

model Review {
  id              String     @id @default(uuid())
  rating          Int
  comment         String?
  difficultyLevel Int
  universityId    String
  university      University @relation(fields: [universityId], references: [id])
  authorId        String?
  author          User?      @relation(fields: [authorId], references: [id])
  editToken         String?
  moderationStatus  ModerationStatus @default(PENDING_MODERATION)
  moderationReason  String?
  createdAt         DateTime         @default(now())
}

model User {
  id                           String                        @id @default(uuid())
  email                        String?                       @unique
  password                     String?
  username                     String                        @unique
  role                         Role                          @default(USER)
  universityEmail              String?                       @unique
  verified                     Boolean                       @default(false)
  emailVerified                Boolean                       @default(false)
  universityId                 String?
  university                   University?                   @relation(fields: [universityId], references: [id])
  createdAt                    DateTime                      @default(now())

  reviews                      Review[]
  courses                      Course[]
  universityEmailVerifications UniversityEmailVerification[]
  emailVerifications           EmailVerification[]
  refreshTokens                RefreshToken[]
  universitySubmissions        UniversitySubmission[]
}

model EmailVerification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model UniversityEmailVerification {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  universityEmail String
  token           String   @unique
  expiresAt       DateTime
  createdAt       DateTime @default(now())
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model UniversitySubmission {
  id           String           @id @default(uuid())
  name         String
  location     String?
  type         UniversityType
  website      String?
  emailDomain  String?
  status       SubmissionStatus @default(PENDING)
  reason       String?
  submitterId  String
  submitter    User             @relation(fields: [submitterId], references: [id])
  universityId String?
  university   University?      @relation(fields: [universityId], references: [id])
  reviewedBy   String?
  reviewedAt   DateTime?
  createdAt    DateTime         @default(now())
}

model Course {
  id          String   @id @default(uuid())
  title       String
  description String
  image       String?
  link        String
  price       Float?
  category    String?
  active      Boolean  @default(true)
  createdBy   String?
  creator     User?    @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
