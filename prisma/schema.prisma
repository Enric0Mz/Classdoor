generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UniversityType {
  PUBLIC
  PRIVATE
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

enum ModerationStatus {
  APPROVED
  PENDING_MODERATION
  REJECTED_OFFENSIVE
  REJECTED_NONSENSE
  REJECTED_OTHER
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EmailVerificationType {
  PERSONAL
  UNIVERSITY
}

enum EmailVerificationStatus {
  PENDING
  USED
  REVOKED
}

enum ExternalReviewSource {
  GOOGLE_MAPS
}

model University {
  id        String              @id @default(uuid())
  name         String              @unique
  abbreviation String?
  location     String
  website      String?
  type      UniversityType
  courses   String[]
  rating    Float?
  createdAt DateTime            @default(now())
  images           UniversityImage[]
  reviews          Review[]
  domains          UniversityDomain[]
  users            User[]
  submissions      UniversitySubmission[]
  externalReviews  ExternalReview[]
}

model ExternalReview {
  id           String               @id @default(uuid())
  rating       Int
  textSnippet  String?
  sourceUrl    String
  source       ExternalReviewSource @default(GOOGLE_MAPS)
  originalDate DateTime
  universityId String
  university   University           @relation(fields: [universityId], references: [id], onDelete: Cascade)
  createdAt    DateTime             @default(now())

  @@unique([sourceUrl])
  @@index([universityId])
}

model UniversityImage {
  id           String     @id @default(uuid())
  url          String
  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@index([universityId])
}

model UniversityDomain {
  id           String     @id @default(uuid())
  domain       String     @unique
  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@index([universityId])
}

model Review {
  id              String     @id @default(uuid())
  rating          Int
  comment         String?
  difficultyLevel Int
  universityId    String
  university      University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  authorId        String?
  author          User?      @relation(fields: [authorId], references: [id], onDelete: SetNull)
  editToken         String?
  moderationStatus  ModerationStatus @default(PENDING_MODERATION)
  moderationReason  String?
  parentReviewId    String?
  parentReview      Review?  @relation("ReviewEditHistory", fields: [parentReviewId], references: [id], onDelete: Cascade)
  childReviews      Review[] @relation("ReviewEditHistory")
  createdAt         DateTime         @default(now())

  @@index([universityId, createdAt])
  @@index([moderationStatus, createdAt])
  @@index([authorId])
}

model User {
  id                           String                        @id @default(uuid())
  email                        String?                       @unique
  password                     String?
  username                     String                        @unique
  role                         Role                          @default(USER)
  googleId                     String?                       @unique
  authProvider                 String                        @default("local")
  universityEmail              String?                       @unique
  verified                     Boolean                       @default(false)
  emailVerified                Boolean                       @default(false)
  universityId                 String?
  university                   University?                   @relation(fields: [universityId], references: [id], onDelete: SetNull)
  createdAt                    DateTime                      @default(now())

  @@index([universityId])

  reviews                      Review[]
  courses                      Course[]
  emailVerificationTokens      EmailVerificationToken[]
  refreshTokens                RefreshToken[]
  universitySubmissions        UniversitySubmission[]
}

model EmailVerificationToken {
  id        String                  @id @default(uuid())
  userId    String
  user      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  type      EmailVerificationType
  token     String                  @unique
  status    EmailVerificationStatus @default(PENDING)
  expiresAt DateTime
  createdAt DateTime                @default(now())

  @@index([userId, type, status])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model UniversitySubmission {
  id           String           @id @default(uuid())
  name         String
  location     String?
  type         UniversityType
  website      String?
  emailDomain  String?
  status       SubmissionStatus @default(PENDING)
  reason       String?
  submitterId  String
  submitter    User             @relation(fields: [submitterId], references: [id], onDelete: Cascade)
  universityId String?
  university   University?      @relation(fields: [universityId], references: [id], onDelete: SetNull)
  reviewedBy   String?
  reviewedAt   DateTime?
  createdAt    DateTime         @default(now())

  @@index([submitterId])
  @@index([status, createdAt])
  @@index([name, status])
}

model Course {
  id          String   @id @default(uuid())
  title       String
  description String
  image       String?
  link        String
  price       Float?
  category    String?
  active      Boolean  @default(true)
  createdBy   String?
  creator     User?    @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, category])
  @@index([createdAt])
}
